edit_banner() {
    clear
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED_BG}${WHITE_BOLD}           MENU PENGATURAN BANNER SSH         ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}[1]${NC} Edit Isi Banner (Teks & Warna HTML)"
    echo -e "  ${YELLOW}[2]${NC} Jalankan / Update Banner ke Sistem"
    echo -e "  ${YELLOW}[x]${NC} Kembali ke Menu Utama"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    read -p "  Pilih opsi [1-2 atau x]: " opt_banner
    
    case $opt_banner in
    1)
        # Opsi 1: Membuka editor nano untuk mengubah isi file banner.txt
        echo -e "${BLUE}[*] Membuka editor... Simpan dengan CTRL+O, Keluar CTRL+X${NC}"
        sleep 2
        # Pastikan file ada sebelum di-edit
        [ -f /etc/banner.txt ] || touch /etc/banner.txt
        nano /etc/banner.txt
        edit_banner
        ;;

     2)
        # Opsi 2: Update Banner Tanpa Merusak File
        echo -e "${BLUE}[*] Menyingkronkan banner dengan Dropbear...${NC}"
        sleep 1
        
        # Hapus dulu baris banner lama agar tidak double
        sed -i '/DROPBEAR_BANNER/d' /etc/default/dropbear
        
        # Tambahkan baris banner yang bersih di akhir file
        echo 'DROPBEAR_BANNER="/etc/banner.txt"' >> /etc/default/dropbear
        
        # Restart service dengan validasi
        systemctl daemon-reload
        systemctl restart dropbear >/dev/null 2>&1
        
        if [ $? -eq 0 ]; then
            echo -e "${GREEN}[ OK ] Banner AKTIF & Dropbear Berhasil Restart!${NC}"
        else
            echo -e "${RED}[ ERROR ] Dropbear Gagal Restart! Cek manual config Mas.${NC}"
        fi
        sleep 3
        edit_banner
        ;;

    x)
        # Kembali ke menu utama script Mas
        menu
        ;;
    *)
        echo -e "${RED}Pilihan tidak tersedia, King!${NC}"
        sleep 1
        edit_banner
        ;;
    esac
}

