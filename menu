add_ssh() {
    clear
    domain="aji.izz-store.my.id"
    # Warna & Gaya Teks
    RED_BG='\033[41m'
    WHITE_BOLD='\033[1;37m'
    YELLOW='\033[1;33m'; CYAN='\033[1;36m'; GREEN='\033[1;32m'
    PURPLE='\033[1;35m'; BLUE='\033[1;34m'; NC='\033[0m'

    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "   ${RED_BG}${WHITE_BOLD}      CREATE SSH PREMIUM - AJIMASTER      ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    read -p "   Username       : " user
    read -p "   Password       : " pass
    read -p "   Limit IP      : " iplimit
    read -p "   Expired (Hari) : " masa_aktif
    
    # --- PROSES PERBAIKAN DI SINI ---
    exp=$(date -d "$masa_aktif days" +"%Y-%m-%d")
    
    # 1. Hapus user lama jika ada, lalu buat baru dengan shell /bin/false
    userdel -f $user > /dev/null 2>&1
    useradd -e $exp -M -s /bin/false $user
    
    # 2. Cara ganti password yang paling kompatibel
    echo "$user:$pass" | chpasswd
    
    # 3. Pastikan shell /bin/false terdaftar di sistem agar Dropbear mau terima
    if ! grep -q "^/bin/false" /etc/shells; then
        echo "/bin/false" >> /etc/shells
    fi
    # --------------------------------
    
    echo "$user $iplimit" >> /etc/ssh/.limit_ip
    
    clear
    echo -e "${CYAN} ╔══════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN} ║${NC}   ${RED_BG}${WHITE_BOLD}      SSH PREMIUM - AJIMASTER       ${NC}   ${CYAN}║${NC}"
