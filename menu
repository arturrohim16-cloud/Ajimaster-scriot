restart_services() {
    clear
    echo "Memperbaiki & Mengunci Service Agar Permanen..."
    
    # Matikan proses manual agar tidak bentrok dengan service
    pkill -f xray
    pkill -f ws-python
    
    # Jalankan lewat jalur resmi (Systemd)
    systemctl daemon-reload
    systemctl restart xray
    systemctl restart nginx
    
    # Jalankan WS Python
    screen -dmS ws python3 /usr/local/bin/ws-python 8080
  
    # Pastikan enable agar saat reboot otomatis nyala
    systemctl enable xray
    systemctl enable nginx
    
    echo "---------------------------------------"
    echo " Service Sekarang Terkunci & Permanen! "
    echo "---------------------------------------"
    sleep 2
    dashboard_utama
}

