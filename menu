add_vmess() {
    clear
    CONF="/usr/local/etc/xray/config.json"
    
    # Kunci Domain Langsung (Agar tidak error file not found)
    domain="aji.izz-store.my.id"

    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\E[44;1;39m       CREATE VMESS ACCOUNT        \E[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    read -p "Username : " user
    read -p "Expired (Days) : " masaaktif

    # Cek apakah jq sudah ada, jika belum install otomatis
    if ! command -v jq &> /dev/null; then
        apt install jq -y &> /dev/null
    fi

    if grep -q "\"email\": \"$user\"" "$CONF"; then
        echo -e "\033[0;31mUser $user Sudah Ada!\033[0m"
        sleep 2
        return
    fi

            # 1. Persiapan Data
    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
    
    # 2. Buka gembok file
    chattr -i /usr/local/etc/xray/config.json

    # 3. SUNTIK UUID KE INDEX 0 DAN 1 (SPESIFIK)
    # Memasukkan UUID random yang sama ke Port 443 dan Port 80 sekaligus
    jq --arg id "$uuid" --arg user "$user" --arg exp "$exp" \
    '.inbounds[0].settings.clients += [{"id": $id, "alterId": 0, "email": ($user + " @ " + $exp)}] | 
     .inbounds[1].settings.clients += [{"id": $id, "alterId": 0, "email": ($user + " @ " + $exp)}]' \
    /usr/local/etc/xray/config.json > /tmp/config.json && mv /tmp/config.json /usr/local/etc/xray/config.json

    # 4. Finalisasi: Restart & Kunci Kembali
    systemctl restart xray
    chattr +i /usr/local/etc/xray/config.json

        # Link Port 443 (TLS) - Sudah Benar
    link1=$(echo -n "{\"v\":\"2\",\"ps\":\"$user\",\"add\":\"$domain\",\"port\":\"443\",\"id\":\"$uuid\",\"aid\":\"0\",\"scy\":\"auto\",\"net\":\"ws\",\"path\":\"/vmess\",\"type\":\"none\",\"host\":\"$domain\",\"tls\":\"tls\",\"sni\":\"$domain\"}" | base64 -w 0)
    
    # Link Port 80 (Non-TLS) - PERBAIKAN: tls harus kosong ""
    link2=$(echo -n "{\"v\":\"2\",\"ps\":\"$user\",\"add\":\"$domain\",\"port\":\"80\",\"id\":\"$uuid\",\"aid\":\"0\",\"scy\":\"auto\",\"net\":\"ws\",\"path\":\"/vmess\",\"type\":\"none\",\"host\":\"$domain\",\"tls\":\"\"}" | base64 -w 0)
    
    # Link Port 443 (gRPC)
    link3=$(echo -n "{\"v\":\"2\",\"ps\":\"$user\",\"add\":\"$domain\",\"port\":\"443\",\"id\":\"$uuid\",\"aid\":\"0\",\"scy\":\"auto\",\"net\":\"grpc\",\"path\":\"vmess-grpc\",\"tls\":\"tls\",\"sni\":\"$domain\"}" | base64 -w 0)

