change_port() {
    clear
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${C}│${BG_RED}             • REAL-TIME PORT MONITOR •             ${C}│${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    printf "${W}  %-20s  %-10s  %-15s ${OFF}\n" "SERVICE NAME" "PORT" "STATUS"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"

    services=("XRAY-TLS:443" "XRAY-HTTP:80" "WS-PYTHON:444" "WS-DROPBEAR:2082" "DROPBEAR:143" "SSH-CORE:22" "OPENVPN:1194")

    for item in "${services[@]}"; do
        name=$(echo $item | cut -d: -f1)
        port=$(echo $item | cut -d: -f2)
        if netstat -tuln | grep -q ":$port "; then
            status="🟢 ${G}ON${OFF}"
        else
            status="🔴 ${R}OFF${OFF}"
        fi
        printf " ${P}%-20s ${W}: ${O}%-9s %-15b\n" "$name" "$port" "$status"
    done

    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e " ${O}[00]${G} PERBAIKI SEMUA PORT (SUPER FIX) ${OFF}"
    echo -e " ${O}[x] ${P} KEMBALI KE MENU UTAMA ${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -ne " ${G}Pilih Opsi : ${OFF}"
    read port_opt

    case $port_opt in
        00 | 0)
            echo -e " ${Y}Menjalankan Perbaikan...${OFF}"
            fuser -k 80/tcp 81/tcp 1194/udp 2>/dev/null #
            systemctl restart xray nginx openvpn-server@server 2>/dev/null
            sleep 2
            menu_10 
            ;;
        x) dashboard_utama ;;
        *) menu_10 ;;
    esac
}

add_bot() {
    clear
    CONF_BOT="/etc/xray/bot.conf"
    
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\E[44;1;39m          SETTING BOT NOTIFIKASI MANUAL       \E[0m"
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

    # Tampilkan data lama jika ada
    if [ -f "$CONF_BOT" ]; then
        source $CONF_BOT
        echo -e " Token Saat Ini   : \033[0;33m$BOT_TOKEN\033[0m"
        echo -e " Chat ID Saat Ini : \033[0;33m$CHAT_ID\033[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    fi

    # Input manual dari user
    read -p " Masukkan Token Bot Telegram : " NEW_TOKEN
    read -p " Masukkan Chat ID Telegram  : " NEW_ID

    # Validasi input tidak boleh kosong
    if [[ -z "$NEW_TOKEN" || -z "$NEW_ID" ]]; then
        echo -e "\033[0;31m[ Error ]\033[0m Token atau ID tidak boleh kosong!"
        sleep 2
        menu
        return
    fi

    # Simpan ke file config pusat agar bisa dipanggil 'source'
    mkdir -p /etc/xray
    echo "BOT_TOKEN=\"$NEW_TOKEN\"" > $CONF_BOT
    echo "CHAT_ID=\"$NEW_ID\"" >> $CONF_BOT

    echo -e "\n\033[0;36m[...]\033[0m Mengetes Koneksi Bot..."
    
    # Kirim pesan tes menggunakan format yang kamu inginkan
    TEXT="✅ *BOT NOTIFIKASI AKTIF*
━━━━━━━━━━━━━━━━━━━━━━
Bot berhasil dihubungkan ke VPS Aji Store!
━━━━━━━━━━━━━━━━━━━━━━
*Status:* Online Gacor"

    TEST_SEND=$(curl -s -X POST "https://api.telegram.org/bot$NEW_TOKEN/sendMessage" \
        --data-urlencode "chat_id=$NEW_ID" \
        --data-urlencode "text=$TEXT" \
        --data-urlencode "parse_mode=Markdown")

    if echo "$TEST_SEND" | grep -q "\"ok\":true"; then
        echo -e "\033[0;32m[ OK ]\033[0m Bot Berhasil Terhubung!"
    else
        echo -e "\033[0;31m[ FAIL ]\033[0m Gagal! Cek Token/ID lagi."
    fi

    sleep 2
    menu
}

