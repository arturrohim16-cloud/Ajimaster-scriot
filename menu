echo -e "\n\033[0;36m[...]\033[0m Menghapus sesi dan merestart service..."
systemctl restart xray
systemctl restart nginx

echo -e "\033[0;32m[ OK ]\033[0m User [$user] berhasil dihapus permanen!"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
sleep 2
menu

}

