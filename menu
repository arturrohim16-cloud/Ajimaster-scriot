    echo -e " \e[1;35m     ╚═╝  ╚═╝╚█████╔╝╚═╝ ╚═══╝ \e[0m"

          # === 1. LOGIKA STATUS SERVER (PENCARIAN NAMA SERVICE WS) ===
    s_ssh=$(systemctl is-active ssh >/dev/null 2>&1 && echo "🟢" || echo "🔴")
    s_xray=$(systemctl is-active xray >/dev/null 2>&1 && echo "🟢" || echo "🔴")
    s_nginx=$(systemctl is-active nginx >/dev/null 2>&1 && echo "🟢" || echo "🔴")
    
    # Mencari service WS dengan berbagai kemungkinan nama
    if systemctl is-active ws-stunnel >/dev/null 2>&1 || systemctl is-active websocket >/dev/null 2>&1 || systemctl is-active python-ws >/dev/null 2>&1; then
        s_ws="🟢"
    else
        s_ws="🔴"
    fi

    # === 2. LOGIKA HITUNG AKUN (REFRESH SETIAP BUKA MENU) ===
    # Pastikan file ini ada sesuai hasil grep kamu tadi
    t_ssh=$(grep -c "###" /etc/xray/ssh_users.txt 2>/dev/null || echo "0")
    t_vms=$(grep -c "###" /etc/xray/config.json 2>/dev/null || echo "0")
    t_vls=$(grep -c "###" /etc/xray/config.json 2>/dev/null || echo "0")
    t_trj=$(grep -c "###" /etc/xray/config.json 2>/dev/null || echo "0")

    # === 3. WARNA (TIDAK BERUBAH - SESUAI REQUEST) ===
    C='\e[1;96m'    # Biru (Garis)
    G='\e[1;92m'    # Hijau (Label)
    W='\e[1;97m'    # Putih (Data)
    O='\e[38;5;208m' # ORANYE (Angka Menu)
    Y='\e[1;93m'    # Kuning (Footer)
    P='\e[1;95m'    # Ungu (Menu)
    BG_RED='\e[1;97;101m' # Judul
    OFF='\e[0m'

    # === 4. TAMPILAN DASHBOARD (PRESISI TOTAL) ===
    clear
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${C}│${BG_RED}           • AJI SYSTEM VPN PANEL MENU •            ${C}│${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "System OS" "$(cat /etc/os-release | grep -i PRETTY_NAME | cut -d'"' -f2 | head -n1)"
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "Server RAM" "$(free -m | awk '/Mem:/ { print $3 "MB / " $2 "MB" }')"
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "System Uptime" "$(uptime -p | cut -d' ' -f2-)"
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "Current Domain" "$(cat /etc/xray/domain 2>/dev/null || echo "No Domain Detected")"
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "IP-VPS" "$(wget -qO- ipinfo.io/ip)"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e " ${G}SSH:$s_ssh ${C}│${OFF} ${G} XRAY:$s_xray ${C}│${OFF} ${G} NGINX:$s_nginx ${C}│${OFF} ${G} WS:$s_ws ${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"

    # === 5. TOTAL AKUN (ANTI-NANDUK & AUTO-UPDATE) ===
    printf "${C}│ ${G}%-10s ${W}: %-8s ${C}│ ${G}%-11s ${W}: %-7s ${C}│\n" "SSH/VPN" "$t_ssh" "VMESS/WS" "$t_vms"
    printf "${C}│ ${G}%-10s ${W}: %-8s ${C}│ ${G}%-11s ${W}: %-7s ${C}│\n" "VLESS/WS" "$t_vls" "TROJAN/WS" "$t_trj"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"

    # === 6. DAFTAR MENU (ANGKA ORANYE) ===
    printf "${P}│ ${O}[01] ${P}SSH VIP   ${P}│ ${O}[09] ${P}AUTO REBOOT ${P}│ ${O}[17] ${P}RESTART    ${P}│\n"
    printf "${P}│ ${O}[02] ${P}VMESS     ${P}│ ${O}[10] ${P}MENU PORT   ${P}│ ${O}[18] ${P}DOMAIN     ${P}│\n"
    printf "${P}│ ${O}[03] ${P}VLESS     ${P}│ ${O}[11] ${P}SPEEDTEST   ${P}│ ${O}[19] ${P}CERT SSL   ${P}│\n"
    printf "${P}│ ${O}[04] ${P}TROJAN    ${P}│ ${O}[12] ${P}RUNNING CEK ${P}│ ${O}[20] ${P}INST UDP   ${P}│\n"
    echo -e "${Y}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    printf "${G}│ ${O}[05] ${G}SHADOW    ${G}│ ${O}[13] ${G}CLEAR LOG   ${G}│ ${O}[21] ${G}CACHE      ${G}│\n"
    printf "${G}│ ${O}[06] ${G}TRIAL     ${G}│ ${O}[14] ${G}CREATE SLOW ${G}│ ${O}[22] ${G}BNDWITH    ${G}│\n"
    printf "${G}│ ${O}[07] ${G}RAM/CPU   ${G}│ ${O}[15] ${G}BCKP/RSTR   ${G}│ ${O}[23] ${G}UP SCRIPT  ${G}│\n"
    printf "${G}│ ${O}[08] ${G}DEL EXP   ${G}│ ${O}[16] ${G}REBOOT VPS  ${G}│ ${O}[24] ${G}MENU BOT   ${G}│\n"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    
    # === 7. FOOTER ===
    printf "${C}│ ${G}%-16s ${W}: %-32s ${C}│\n" "Script Version" "V2.4"
    printf "${C}│ ${G}%-16s ${G}: %-32s ${C}│\n" "Script Status" "(Active)"
    printf "${C}│ ${G}%-16s ${Y}: %-32s ${C}│\n" "Username" "AJI STORE"
    printf "${C}│ ${G}%-16s ${Y}: %-32s ${C}│\n" "Expired script" "UNLIMITED"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo ""
    read -p "  Pilih Nomor: " opt
       # === LOGIKA PEMILIHAN MENU (SINKRON DENGAN TAMPILAN) ===
    case $opt in
        1|01) add_ssh ;;              # MENU SSH VIP
        2|02) add_vmess ;;            # MENU VMESS
        3|03) add_vless ;;            # MENU VLESS
        4|04) add_trojan ;;           # MENU TROJAN
        5|05) add_ssws ;;             # MENU SHADOW
        6|06) trial_menu ;;           # MENU TRIAL
        7|07) cek_ram ;;              # CEK RAM/CPU
        8|08) del_exp ;;              # DELL ALL EXP
        9|09) auto_reboot ;;          # AUTO REBOOT
        10) change_port ;;            # MENU PORT
        11) run_speedtest ;;          # SPEEDTEST
        12) running_cek ;;            # RUNNING CEK
        13) clear_log ;;              # CLEAR LOG
        14) add_slowdns ;;            # CREATE SLOW
        15) backup_restore ;;         # BCKP/RSTR
        16) reboot_vps ;;             # REBOOT VPS
        17) restart_services ;;       # RESTART VPS
        18) set_domain ;;             # SET DOMAIN
        19) cert_v2ray ;;             # CERT SSL
        20) install_udp ;;            # INSTALL UDP
        21) clear_cache ;;            # CLEAR CACHE
        22) cek_bandwith ;;           # CEK BANDWITH
        23) update_script ;;          # UP SCRIPT
        24) menu_bot ;;               # MENU BOT VIP
        25) edit_banner ;;            # CHANGE BANNER SSH
        26) view_log_create ;;        # LOG CREATE USER
        0|00) exit ;;                 # EXIT MENU
        *) menu ;;                    # KEMBALI KE MENU JIKA SALAH TEKAN
    esac
}

menu() {
    dashboard_utama
}

dashboard_utama
