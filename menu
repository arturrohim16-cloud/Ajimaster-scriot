clear_log() {
    clear
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${C}│${BG_RED}               • CLEARING SYSTEM LOG •              ${C}│${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -ne " Cleaning logs, please wait..."
    # Menghapus semua file log di direktori umum
    find /var/log -type f -name "*.log" -exec truncate -s 0 {} \;
    find /var/log -type f -name "*.gz" -delete
    rm -rf /var/log/journal/*
    echo -e "${G} DONE!${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    read -n 1 -s -r -p " Press any key to back to menu..."
    dashboard_utama
}

