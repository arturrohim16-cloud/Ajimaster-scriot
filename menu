    done
    echo "----------------------------"
    read -n 1 -s -r -p "Tekan sembarang tombol untuk kembali"
    menu_manager
}

hapus_manual() {
# =========================================================
#  FUNGSI DISPLAY & HAPUS USER (SSH & XRAY) BY GEMINI
# =========================================================

# --- 1. WARNA ---
CYAN='\033[0;36m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
PURPLE='\033[0;35m'
RED='\033[0;31m'
NC='\033[0m'

clear
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "          ${PURPLE}🔍 LIST ACTIVE USERS DETAILS${NC}          "
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# --- 2. TAMPILAN LIST USER ---

# Bagian SSH & OpenVPN
echo -e "${YELLOW} [ SSH & OpenVPN Users ] ${NC}"
awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | nl -s ". " | while read line; do
    echo -e "${GREEN}  $line${NC}"
done
echo -e "${CYAN}-------------------------------------------------${NC}"

# Bagian VMESS
echo -e "${YELLOW} [ VMESS Users ] ${NC}"
if [ -s /etc/xray/vmess_users.txt ]; then
    grep -E "^### " "/etc/xray/vmess_users.txt" | cut -d ' ' -f 2-3 | nl -s ". " | while read line; do
        echo -e "${GREEN}  $line${NC}"
    done
else
    echo -e "  ${BLUE}No vmess users found.${NC}"
fi
echo -e "${CYAN}-------------------------------------------------${NC}"

# Bagian VLESS
echo -e "${YELLOW} [ VLESS Users ] ${NC}"
if [ -s /etc/xray/vless_users.txt ]; then
    grep -E "^### " "/etc/xray/vless_users.txt" | cut -d ' ' -f 2-3 | nl -s ". " | while read line; do
        echo -e "${GREEN}  $line${NC}"
    done
else
    echo -e "  ${BLUE}No vless users found.${NC}"
fi
echo -e "${CYAN}-------------------------------------------------${NC}"

# Bagian TROJAN
echo -e "${YELLOW} [ TROJAN Users ] ${NC}"
if [ -s /etc/xray/trojan_users.txt ]; then
    grep -E "^### " "/etc/xray/trojan_users.txt" | cut -d ' ' -f 2-3 | nl -s ". " | while read line; do
        echo -e "${GREEN}  $line${NC}"
    done
else
    echo -e "  ${BLUE}No trojan users found.${NC}"
fi
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# --- 3. PROSES HAPUS ALL-IN-ONE ---

CONF="/usr/local/etc/xray/config.json"

read -p " Ketik Nama User yang ingin dihapus: " user

if [ -z "$user" ]; then
    echo -e "${RED} Error: Nama tidak boleh kosong!${NC}"
    sleep 2
    return
fi

echo -e "\n${CYAN}Sedang membersihkan user [ $user ]...${NC}"

# Hapus SSH (Sistem)
if id "$user" &>/dev/null; then
    userdel -f "$user" &>/dev/null
    echo -e "${GREEN} [OK]${NC} User SSH [ $user ] dihapus."
fi

# Hapus Xray (Config JSON)
if [ -f "$CONF" ]; then
    jq --arg mail "$user" 'del(.inbounds[].settings.clients[]? | select(.email == $mail))' "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    echo -e "${GREEN} [OK]${NC} User Xray [ $user ] dihapus dari config."
fi

# Hapus Log TXT
sed -i "/$user/d" /etc/xray/vmess_users.txt 2>/dev/null
sed -i "/$user/d" /etc/xray/vless_users.txt 2>/dev/null
sed -i "/$user/d" /etc/xray/trojan_users.txt 2>/dev/null
echo -e "${GREEN} [OK]${NC} Log database dibersihkan."

# Restart Service
chown root:root "$CONF"
chmod 644 "$CONF"
systemctl restart xray &>/dev/null

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "  ${GREEN}BERHASIL:${NC} Akun [ $user ] telah dihapus total!"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
sleep 3
    echo -ne "${KUNING}Press any key to back to menu${NC}"
    read -n 1 -s -r
    dashboard_utama
}

