# === TARUH DI ATAS SCRIPT ===
change_port() {
    clear
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${C}│${BG_RED}             • REAL-TIME PORT MONITOR •             ${C}│${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    printf "${W}  %-20s  %-10s  %-15s ${OFF}\n" "SERVICE NAME" "PORT" "STATUS"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"

    services=("XRAY-TLS:443" "XRAY-HTTP:80" "WS-PYTHON:444" "WS-DROPBEAR:2082" "DROPBEAR:143" "SSH-CORE:22" "OPENVPN:1194")

    for item in "${services[@]}"; do
        name=$(echo $item | cut -d: -f1)
        port=$(echo $item | cut -d: -f2)
        if netstat -tuln | grep -q ":$port "; then
            status="🟢 ${G}ON${OFF}"
        else
            status="🔴 ${R}OFF${OFF}"
        fi
        printf " ${P}%-20s ${W}: ${O}%-9s %-15b\n" "$name" "$port" "$status"
    done

    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e " ${O}[00]${G} PERBAIKI SEMUA PORT (SUPER FIX) ${OFF}"
    echo -e " ${O}[x] ${P} KEMBALI KE MENU UTAMA ${OFF}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -ne " ${G}Pilih Opsi : ${OFF}"
    read port_opt

    case $port_opt in
        00 | 0)
            echo -e " ${Y}Menjalankan Perbaikan...${OFF}"
            fuser -k 80/tcp 81/tcp 1194/udp 2>/dev/null #
            systemctl restart xray nginx openvpn-server@server 2>/dev/null
            sleep 2
            menu_10 
            ;;
        x) dashboard_utama ;;
        *) menu_10 ;;
    esac
}

