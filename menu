# Fungsi Hapus User Manual (Permanen) dengan Daftar Akun
del_exp() {
# =========================================================
# FUNGSI DISPLAY & HAPUS USER (SSH & XRAY) BY GEMINI
# =========================================================
# Script Hapus Akun Sampai Akar - AJI STORE
CONF="/usr/local/etc/xray/config.json"
clear
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\E[44;1;39m          HAPUS AKUN SAMPAI KE AKAR           \E[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

# 1. Cek apakah jq terinstall
if ! command -v jq &> /dev/null; then
    apt install jq -y &> /dev/null
fi

# 2. LOGIKA SCAN USER (Membaca semua sumber agar user baru/lama muncul)
echo -e " Daftar User yang Terdeteksi:"

# Mengambil user dari semua database txt dan config xray
USER_XRAY=$(grep -hE "###" /etc/xray/*.txt 2>/dev/null | cut -d ' ' -f 2)
USER_XRAY_JSON=$(grep -E "email" $CONF 2>/dev/null | cut -d '"' -f 4)
USER_SSH=$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd)

# Gabungkan semua, urutkan, dan hapus duplikat
USER_LIST=$(echo -e "$USER_XRAY\n$USER_XRAY_JSON\n$USER_SSH" | grep -v "^$" | sort | uniq)

if [[ -z "$USER_LIST" ]]; then
    echo -e " \033[0;31m[!]\033[0m Tidak ada user yang ditemukan."
    echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    read -p " Press Enter to return to menu..."
    menu
    return
fi

# Tampilkan list dengan rapi (2 kolom agar tidak terlalu panjang ke bawah)
echo "$USER_LIST" | sed 's/^/ - /' | column
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

read -p " Masukkan Username yang akan dihapus: " user

if [[ -z "$user" ]]; then
    echo -e " \033[0;31m[ Error ]\033[0m Nama user tidak boleh kosong!"
    sleep 2
    menu
    return
fi

# 3. Eksekusi Hapus dari Config Xray (VMess, VLess, Trojan)
chattr -i $CONF 2>/dev/null
jq --arg user "$user" 'del(.inbounds[].settings.clients[]? | select(.email == $user))' $CONF > /tmp/config.json && mv /tmp/config.json $CONF

# 4. Bersihkan dari Database TXT (Semua Jalur)
sed -i "/### $user/d" /etc/xray/users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/trojan_users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/vless_users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/vmess_users.txt 2>/dev/null

# --- 5. EKSEKUSI HAPUS (MENCARI UUID & NAMA) ---
echo -e "\n\033[0;36m[...]\033[0m Melacak ID Akun dan Menghapus..."

# A. Ambil UUID user tersebut sebelum dihapus
USER_UUID=$(grep -B 3 "\"email\": \"$user\"" $CONF | grep '"id":' | cut -d '"' -f 4)

# B. Buka Kunci & Hapus menggunakan JQ
chattr -i $CONF 2>/dev/null
if [[ -n "$USER_UUID" ]]; then
    jq --arg email "$user" --arg id "$USER_UUID" 'del(.inbounds[].settings.clients[]? | select(.email == $email or .id == $id))' $CONF > /tmp/config.json && mv /tmp/config.json $CONF
else
    jq --arg email "$user" 'del(.inbounds[].settings.clients[]? | select(.email == $email))' $CONF > /tmp/config.json && mv /tmp/config.json $CONF
fi

# C. Hapus dari Database Teks (PENTING: Agar Total Akun Berkurang)
sed -i "/^### $user /d" /etc/xray/users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/trojan_users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/vless_users.txt 2>/dev/null
sed -i "/### $user/d" /etc/xray/vmess_users.txt 2>/dev/null
# Hapus juga dari database SSH
sed -i "/^$user /d" /etc/ssh/.ssh.db 2>/dev/null

# D. Hapus User dari Sistem Linux (SSH)
userdel -f $user > /dev/null 2>&1

# --- 6. RESET TOTAL & FORCE DISCONNECT ---
echo -e "\033[0;36m[...]\033[0m Mematikan paksa koneksi user $user..."

# TENDANG USER DARI SSH/WS (Ini kuncinya agar langsung mati di HP!)
pkill -u $user 2>/dev/null

# Restart Service agar Config Baru Terbaca
systemctl restart xray nginx 2>/dev/null

# Membersihkan jalur data di level Kernel
if command -v conntrack &> /dev/null; then
    conntrack -F 2>/dev/null
fi

chattr +i $CONF 2>/dev/null

echo -e "\033[0;32m[ OK ]\033[0m Akun [$user] TELAH MATI TOTAL & DIHAPUS DARI LIST!"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
sleep 2
menu

}

