    read -p "Username : " user
    read -p "Expired (Days) : " masaaktif

    # Cek apakah jq sudah ada
    if ! command -v jq &> /dev/null; then
        apt install jq -y &> /dev/null
    fi

    # Cek user dobel
    if grep -q "\"email\": \"$user\"" "$CONF"; then
        echo -e "\033[0;31mUser $user Sudah Ada!\033[0m"
        sleep 2
        return
    fi

    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=`date -d "$masaaktif days" +"%Y-%m-%d"`

    # --- PROSES DAFTAR UUID KE SEMUA INBOUND VLESS (443 & 10002) ---
    # Perintah ini akan otomatis mengisi semua port yang pakai protokol vless
    jq --arg id "$uuid" --arg mail "$user" '(.inbounds[] | select(.protocol == "vless")).settings.clients += [{"id": $id, "decryption": "none", "email": $mail}]' "$CONF" > /tmp/config.json && mv /tmp/config.json "$CONF"

    # Tambahkan komentar expired di atas baris email user agar sinkron dengan dashboard
    sed -i "/\"email\": \"$user\"/i \### $user $exp" "$CONF"

    # Fix Permission & Restart
    chown root:root "$CONF" && chmod 644 "$CONF"
    systemctl restart xray
    systemctl restart nginx

    # --- GENERATE LINK VLESS ---
    link1="vless://$uuid@$domain:443?path=/vless&security=tls&encryption=none&type=ws&sni=$domain#$user"
    link2="vless://$uuid@$domain:80?path=/vless&security=none&encryption=none&type=ws&host=$domain#$user"
