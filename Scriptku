    echo -e "-------------------------------------------"
    read -p " Pilih Menu : " opt_sub
    case $opt_sub in
        1) if [[ "$2" == "ssh" ]]; then create_ssh; else xray_manager "$1"; fi ;;
        2) 
           user="trial$(($RANDOM%1000))"; exp=$(date -d "1 days" +%Y-%m-%d)
           if [[ "$2" == "ssh" ]]; then
              useradd -e $exp -M -s /bin/false "$user"; echo "$user:1" | chpasswd
              echo "$user|1|$exp|1|0|ssh" >> /etc/aji/users.db
           else
              uuid=$(cat /proc/sys/kernel/random/uuid)
              jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$user\"}]" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
              systemctl restart xray
              echo "$user|$uuid|$exp|1|0|$1" >> /etc/aji/users.db
           fi
           echo -e "${GREEN}Trial Berhasil Dibuat${NC}"; sleep 2; dashboard_utama ;;
        3) renew-user ;;
        4) del-user ;;
        0) dashboard_utama ;;
        *) menu_manager "$1" "$2" ;;
    esac
}

del_user() {
    clear
    echo -e "╔════════════════════════════════════════════╗"
    echo -e "║            DELETE XRAY ACCOUNT             ║"
    echo -e "╚════════════════════════════════════════════╝"
    echo -e "  Daftar User Aktif di VPS:"
    echo -e "╟─────────────────────────────────────────────"
    grep -E "^### " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | nl -s ") "
    echo -e "╟─────────────────────────────────────────────"
    read -p "  Ketik Nama User yang ingin dihapus: " user
    if [[ -z "$user" ]]; then menu; fi

    sed -i "/^### $user/,/^#&/d" /etc/xray/config.json
    systemctl restart xray
    
    clear
    echo -e "╔════════════════════════════════════════════╗"
    echo -e "║          PROSES HAPUS BERHASIL             ║"
    echo -e "╠════════════════════════════════════════════╝"
