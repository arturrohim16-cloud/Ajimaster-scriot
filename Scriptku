#!/bin/bash
update_script() {
    clear
    echo -e "\e[1;33mMemeriksa pembaruan script...\e[0m"
    # Ganti link di bawah ini dengan link RAW github menu Mas
    wget -q -O /usr/bin/menu "https://raw.githubusercontent.com/username/repo/main/menu"
