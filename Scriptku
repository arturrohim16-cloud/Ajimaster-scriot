    echo -e "╟─────────────────────────────────────────────"
    echo -e "║ Sistem Xray telah diperbarui otomatis"
    echo -e "╚════════════════════════════════════════════╝"
    echo ""
    read -p "  Tekan Enter untuk kembali ke Menu"
    menu
}

renew_user() {
    clear
    echo -e "   \e[1;35m╔════════════════════════════════════════════╗\e[0m"
    echo -e "   \e[1;35m║\e[0m       \e[1;107;32m PERPANJANG MASA AKTIF USER \e[0m       \e[1;35m║\e[0m"
    echo -e "   \e[1;35m╚════════════════════════════════════════════╝\e[0m"
    echo -e ""
    read -p "  Masukkan Username : " u
    if grep -q -w "$u" /etc/aji/users.db; then
        read -p "  Tambah Masa Aktif (Hari) : " days
        exp_old=$(grep -w "$u" /etc/aji/users.db | cut -d'|' -f3)
        exp_new=$(date -d "$exp_old + $days days" +%Y-%m-%d)
        sed -i "s/$exp_old/$exp_new/g" /etc/aji/users.db
        clear
        echo -e "   \e[1;35m╔════════════════════════════════════════════╗\e[0m"
        echo -e "   \e[1;35m║\e[0m          \e[1;32mRENEW ACCOUNT SUCCESS\e[0m             \e[1;35m║\e[0m"
        echo -e "   \e[1;35m╠════════════════════════════════════════════╝\e[0m"
        echo -e "   \e[1;35m║\e[0m User: \e[1;107;32m $u \e[0m"
        echo -e "   \e[1;35m║\e[0m Expired Baru: \e[1;32m$exp_new\e[0m"
        echo -e "   \e[1;35m╚════════════════════════════════════════════╝\e[0m"
    else
        echo -e "   \e[1;31m[!] User Tidak Ditemukan!\e[0m"
    fi
    echo ""
    read -p "  Tekan Enter untuk kembali ke Menu"
    menu
}

restart_services() {
    clear
