function xray_manager() {
    clear
    proto_type=$1
    echo -e "╔════════════════════════════════════════════╗"
    echo -e "║        CREATE $proto_type ACCOUNT PREMIUM        ║"
    echo -e "╚════════════════════════════════════════════╝"
    read -p "  Username : " user
    [[ -z "$user" ]] && menu
    read -p "  Limit IP : " iplim
    read -p "  Masa Aktif (Hari) : " aktif
    
    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=$(date -d "$aktif days" +%Y-%m-%d)
    
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$user\"}]" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
    systemctl restart xray
    
    echo "$user|$uuid|$exp|$iplim|0|$proto_type" >> /etc/aji/users.db
    
    if [[ "$proto_type" == "VMESS" ]]; then
        cat <<EOF > /etc/aji/vmess_tls.json
{"v":"2","ps":"$user","add":"$DOMAIN","port":"443","id":"$uuid","aid":"0","net":"ws","path":"/vmess","type":"none","host":"$DOMAIN","tls":"tls"}
EOF
        cat <<EOF > /etc/aji/vmess_http.json
{"v":"2","ps":"$user","add":"$DOMAIN","port":"80","id":"$uuid","aid":"0","net":"ws","path":"/vmess","type":"none","host":"$DOMAIN","tls":"none"}
EOF
        link_vmess="vmess://$(base64 -w 0 /etc/aji/vmess_tls.json)"
        link_http="vmess://$(base64 -w 0 /etc/aji/vmess_http.json)"
        link_grpc="vmess://$uuid@$DOMAIN:443?path=/vmess-grpc&security=tls&encryption=none&type=grpc&serviceName=vmess-grpc#$user"
    elif [[ "$proto_type" == "VLESS" ]]; then
        link_vmess="vless://$uuid@$DOMAIN:443?path=/vless&security=tls&encryption=none&type=ws#$user"
        link_http="vless://$uuid@$DOMAIN:80?path=/vless&security=none&encryption=none&type=ws#$user"
        link_grpc="vless://$uuid@$DOMAIN:443?path=/vless-grpc&security=tls&encryption=none&type=grpc&serviceName=vless-grpc#$user"
    elif [[ "$proto_type" == "TROJAN" ]]; then
        link_vmess="trojan://$uuid@$DOMAIN:443?path=/trojan&security=tls&type=ws#$user"
        link_http="trojan://$uuid@$DOMAIN:80?path=/trojan&security=none&type=ws#$user"
        link_grpc="trojan://$uuid@$DOMAIN:443?path=/trojan-grpc&security=tls&type=grpc&serviceName=trojan-grpc#$user"
    fi

    clear
    echo -e "╔════════════════════════════════════════════╗"
    echo -e "║         $proto_type ACCOUNT DETAIL             ║"
    echo -e "╠════════════════════════════════════════════╝"
    echo -e "║ Remarks   : $user"
    echo -e "║ Domain    : $DOMAIN"
    echo -e "║ Limit IP  : $iplim Perangkat"
    echo -e "║ UUID      : $uuid"
    echo -e "║ Expired   : $exp"
    echo -e "╟─────────────────────────────────────────────"
    echo -e "║ Link VMESS / TLS (443) :"
    echo -e "║ \e[107;32m$link_vmess\e[0m"
    echo -e "╟─────────────────────────────────────────────"
    echo -e "║ Link HTTP / Non-TLS (80) :"
    echo -e "║ \e[107;32m$link_http\e[0m"
    echo -e "╟─────────────────────────────────────────────"
    echo -e "║ Link gRPC (Multi Port) :"
    echo -e "║ \e[107;32m$link_grpc\e[0m"
    echo -e "╚════════════════════════════════════════════╝"
    echo -e "  $proto_type Berhasil Dibuat!"
    echo ""
    read -p "  Tekan Enter untuk kembali ke Menu"
    menu
}

