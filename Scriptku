        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
    }

    location /ssh {
        if (\$http_upgrade != "websocket") { return 404; }
        proxy_redirect off;
        proxy_pass http://127.0.0.1:8880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
    }
}
EOF

    # 3c. Install Python WebSocket
    cat <<EOF > /usr/bin/ws-python
import socket, threading
def forward(src, dst):
    while True:
        try:
            data = src.recv(1024)
            if not data: break
            dst.send(data)
        except: break
def proxy(client):
    try:
        data = client.recv(1024).decode('utf-8', errors='ignore')
        if "Upgrade: websocket" in data:
            client.send(b'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n')
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.connect(('127.0.0.1', 22))
            threading.Thread(target=forward, args=(client, target)).start()
            threading.Thread(target=forward, args=(target, client)).start()
    except: client.close()
def main():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(('127.0.0.1', 8880))
    server.listen(100)
    while True:
        client, addr = server.accept()
        threading.Thread(target=proxy, args=(client,)).start()
if __name__ == '__main__':
    main()
EOF

