cek_user() {
    clear
    echo -e "   \e[1;35m╔════════════════════════════════════════════╗\e[0m"
    echo -e "   \e[1;35m║\e[0m           \e[1;107;32m CEK USER LOGIN ONLINE \e[0m          \e[1;35m║\e[0m"
    echo -e "   \e[1;35m╚════════════════════════════════════════════╝\e[0m"
    if [ -f /var/log/xray/access.log ]; then
        data=$(grep -E "accepted" /var/log/xray/access.log | cut -d ' ' -f 7 | sort | uniq | cut -d: -f1)
    else
        data=""
    fi
    if [[ -z "$data" ]]; then
        echo -e "  ║ Status: \e[107;31m TIDAK ADA USER ONLINE \e[0m"
    else
        for user in $data; do
            if [[ ! -z "$user" ]]; then
                echo -e "  ║ User: \e[107;32m $user \e[0m [ONLINE]"
            fi
        done
    fi
    echo ""
    read -p "  Tekan Enter untuk kembali ke Menu"
    menu
}

