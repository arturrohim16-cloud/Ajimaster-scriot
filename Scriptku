# --- FUNGSI CEK ONLINE ---
cek_online() {
    clear
    echo -e " \e[1;32mCEK USER ONLINE\e[0m"
    echo "----------------------------"
    # Cek SSH Online
    echo -e "\e[1;33m[ SSH ONLINE ]\e[0m"
    if [[ -e /etc/openvpn/server/openvpn-status.log ]]; then
        grep -E "([0-9]{1,3}\.){3}[0-9]{1,3}" /etc/openvpn/server/openvpn-status.log | cut -d ',' -f 1,2 | sed 's/,/ -> /'
    fi
    # Cek Xray Online (biasanya butuh jq)
    echo -e "\n\e[1;33m[ XRAY ONLINE ]\e[0m"
    data=( `cat /etc/xray/config.json | grep '^###' | cut -d ' ' -f 2 | sort | uniq` )
    for user in "${data[@]}"; do
        log=$(grep "email: $user" /var/log/xray/access.log | tail -n 1)
        if [[ -n "$log" ]]; then echo "User: $user [Active]"; fi
    done
    echo "----------------------------"
    read -n 1 -s -r -p "Tekan sembarang tombol untuk kembali"
    menu_manager
}

hapus_manual() {
    clear
    BIRU='\033[1;34m'
    KUNING='\033[1;33m'
    CYAN='\033[1;36m'
    NC='\033[0m'
    CONF="/usr/local/etc/xray/config.json"

    echo -e "${BIRU}=======================================${NC}"
    echo -e "       ${KUNING}PENGHAPUSAN AKUN (PER KATEGORI)${NC}  "
    echo -e "${BIRU}=======================================${NC}"

    # --- 1. DAFTAR SSH ---
    echo -e "  ${CYAN}[ SSH Users ]${NC}"
    echo -ne "${KUNING}"
    awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | nl -s '. '
    echo -ne "${NC}"
    echo -e "${BIRU}---------------------------------------${NC}"

    # --- 2. DAFTAR VMESS ---
    echo -e "  ${CYAN}[ VMESS Users ]${NC}"
    echo -ne "${KUNING}"
    # Mengambil email dari baris yang ada kata 'alterId' (ciri Vmess)
    grep "alterId" $CONF | grep -oP '(?<="email": ")[^"]*' | grep -v "admin" | sort | uniq | nl -s '. '
    echo -ne "${NC}"
    echo -e "${BIRU}---------------------------------------${NC}"

    # --- 3. DAFTAR VLESS ---
    echo -e "  ${CYAN}[ VLESS Users ]${NC}"
    echo -ne "${KUNING}"
    # Mengambil email dari baris yang ada ID tapi TIDAK ada alterId (ciri Vless Mas)
    grep "\"id\":" $CONF | grep -v "alterId" | grep -oP '(?<="email": ")[^"]*' | grep -v "admin" | sort | uniq | nl -s '. '
    echo -ne "${NC}"
    echo -e "${BIRU}---------------------------------------${NC}"

    # --- 4. DAFTAR TROJAN ---
    echo -e "  ${CYAN}[ TROJAN Users ]${NC}"
    echo -ne "${KUNING}"
    # Mengambil email dari baris yang ada kata 'password' (ciri Trojan)
    grep "password" $CONF | grep -oP '(?<="email": ")[^"]*' | grep -v "admin" | sort | uniq | nl -s '. '
    echo -ne "${NC}"
    echo -e "${BIRU}=======================================${NC}"
    echo ""

    echo -ne "${KUNING}Ketik Nama User yang ingin dihapus: ${NC}"
    read -r user

    if [[ -z $user ]]; then
        echo -e "${KUNING}Nama tidak boleh kosong!${NC}"
        sleep 1; return
    fi

    # PROSES HAPUS SANGAT AKURAT
    # Menghapus satu blok klien yang mengandung email tersebut
    sed -i "/\"email\": \"$user\"/d" $CONF
    # Menghapus jika ada sisa baris kosong
    sed -i '/^$/d' $CONF
    
    # Hapus User SSH jika ada
    userdel -f "$user" &>/dev/null
    
    systemctl restart xray &>/dev/null
    systemctl restart ssh &>/dev/null

    echo -e "${BIRU}---------------------------------------${NC}"
    echo -e "  ${KUNING}User [ $user ] Berhasil Dihapus!${NC}"
    echo -e "${BIRU}---------------------------------------${NC}"
    echo -ne "${KUNING}Press any key to back to menu${NC}"
    read -n 1 -s -r
    dashboard_utama
}

exp_cleaner() {
