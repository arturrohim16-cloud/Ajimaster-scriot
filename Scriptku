# --- FUNGSI CEK ONLINE ---
cek_online() {
    clear
    echo -e " \e[1;32mCEK USER ONLINE\e[0m"
    echo "----------------------------"
    # Cek SSH Online
    echo -e "\e[1;33m[ SSH ONLINE ]\e[0m"
    if [[ -e /etc/openvpn/server/openvpn-status.log ]]; then
        grep -E "([0-9]{1,3}\.){3}[0-9]{1,3}" /etc/openvpn/server/openvpn-status.log | cut -d ',' -f 1,2 | sed 's/,/ -> /'
    fi
    # Cek Xray Online (biasanya butuh jq)
    echo -e "\n\e[1;33m[ XRAY ONLINE ]\e[0m"
    data=( `cat /etc/xray/config.json | grep '^###' | cut -d ' ' -f 2 | sort | uniq` )
    for user in "${data[@]}"; do
        log=$(grep "email: $user" /var/log/xray/access.log | tail -n 1)
        if [[ -n "$log" ]]; then echo "User: $user [Active]"; fi
    done
    echo "----------------------------"
    read -n 1 -s -r -p "Tekan sembarang tombol untuk kembali"
    menu_manager
}

hapus_manual() {
    clear
    echo -e " ======================================="
    echo -e "       DAFTAR AKUN AKTIF (ALL)          "
    echo -e " ======================================="
    echo -e "  [ SSH Users ]"
    grep -E "^### " "/etc/xray/ssh.db" | cut -d ' ' -f 2 | nl -s '. '
    echo -e " ---------------------------------------"
    echo -e "  [ VMESS Users ]"
    grep -E "^### " "/usr/local/etc/xray/config.json" | cut -d ' ' -f 2 | nl -s '. '
    echo -e " ---------------------------------------"
    echo -e "  [ VLESS Users ]"
    grep -E "^#& " "/usr/local/etc/xray/config.json" | cut -d ' ' -f 2 | nl -s '. '
    echo -e " ---------------------------------------"
    echo -e "  [ TROJAN Users ]"
    grep -E "^#! " "/usr/local/etc/xray/config.json" | cut -d ' ' -f 2 | nl -s '. '
    echo -e " ======================================="
    echo ""
    read -rp " Ketik Nama User yang ingin dihapus: " user
    
    if [[ -z $user ]]; then
        echo " Nama tidak boleh kosong, King!"
        sleep 1
        return
    fi

    # Proses Hapus dari Config Xray (Vmess/Vless/Trojan)
    sed -i "/^### $user/,/^#vmess/d" /usr/local/etc/xray/config.json
    sed -i "/^#& $user/,/^#vless/d" /usr/local/etc/xray/config.json
    sed -i "/^#! $user/,/^#trojan/d" /usr/local/etc/xray/config.json
    
    # Proses Hapus User SSH (Jika ada)
    userdel -f "$user" &>/dev/null
    sed -i "/^### $user/d" /etc/xray/ssh.db &>/dev/null

    # Restart Service agar perubahan efek
    systemctl restart xray
    
    echo -e " ---------------------------------------"
    echo -e "  User [ $user ] Berhasil Dihapus!      "
    echo -e " ---------------------------------------"
    read -n 1 -s -r -p " Press any key to back to menu"
    menu
}

