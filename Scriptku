# --- FUNGSI CEK ONLINE ---
cek_online() {
    clear
    echo -e " \e[1;32mCEK USER ONLINE\e[0m"
    echo "----------------------------"
    # Cek SSH Online
    echo -e "\e[1;33m[ SSH ONLINE ]\e[0m"
    if [[ -e /etc/openvpn/server/openvpn-status.log ]]; then
        grep -E "([0-9]{1,3}\.){3}[0-9]{1,3}" /etc/openvpn/server/openvpn-status.log | cut -d ',' -f 1,2 | sed 's/,/ -> /'
    fi
    # Cek Xray Online (biasanya butuh jq)
    echo -e "\n\e[1;33m[ XRAY ONLINE ]\e[0m"
    data=( `cat /etc/xray/config.json | grep '^###' | cut -d ' ' -f 2 | sort | uniq` )
    for user in "${data[@]}"; do
        log=$(grep "email: $user" /var/log/xray/access.log | tail -n 1)
        if [[ -n "$log" ]]; then echo "User: $user [Active]"; fi
    done
    echo "----------------------------"
    read -n 1 -s -r -p "Tekan sembarang tombol untuk kembali"
    menu_manager
}

del_user() {
    clear
    echo -e "\e[1;31m      HAPUS USER (SSH & XRAY) PERMANEN\e[0m"
    echo -e "-----------------------------------------------"
    read -p "   Masukkan Username yg akan dihapus : " user
    
    # 1. Hapus dari Sistem SSH
    if grep -w "^$user" /etc/passwd > /dev/null; then
        userdel -f $user
        echo -e "   - Akun SSH [$user] Berhasil Dihapus!"
    fi
    
    # 2. Hapus dari Config Xray (Vmess, Vless, Trojan)
    if grep -qw "$user" /etc/xray/config.json; then
        # Menghapus blok user berdasarkan nama di config xray
        sed -i "/### $user/,/^},{/d" /etc/xray/config.json
        systemctl restart xray
        echo -e "   - Akun Xray [$user] Berhasil Dihapus!"
    else
        echo -e "   - Akun Xray [$user] Tidak Ditemukan!"
    fi
    
    echo -e "-----------------------------------------------"
    echo -e "   Proses Selesai!"
    sleep 2
    menu_manager
}

