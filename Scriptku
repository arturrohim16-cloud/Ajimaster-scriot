del-user() {
    clear
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e "             HAPUS PENGGUNA (DELETE)               "
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    read -p " Masukkan Username yang akan dihapus: " u
    if grep -q -w "$u" /etc/aji/users.db; then
        proto=$(grep -w "$u" /etc/aji/users.db | cut -d'|' -f6)
        if [[ "$proto" == "ssh" ]]; then 
            userdel -f "$u"
        else
            jq "del(.inbounds[0].settings.clients[] | select(.email == \"$u\"))" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
            systemctl restart xray
        fi
        sed -i "/^$u|/d" /etc/aji/users.db
        echo -e "${GREEN}User $u Berhasil Dihapus!${NC}"
    else
        echo -e "${RED}User Tidak Ditemukan!${NC}"
    fi
    sleep 2; dashboard_utama
}

renew-user() {
    clear
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e "            PERPANJANG MASA AKTIF (RENEW)          "
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    read -p " Masukkan Username: " u
    if grep -q -w "$u" /etc/aji/users.db; then
        read -p " Tambah Masa Aktif (Hari): " days
        exp_old=$(grep -w "$u" /etc/aji/users.db | cut -d'|' -f3)
        exp_new=$(date -d "$exp_old + $days days" +%Y-%m-%d)
        sed -i "s/$exp_old/$exp_new/g" /etc/aji/users.db
        echo -e "${GREEN}User $u diperpanjang ke $exp_new${NC}"
    else
        echo -e "${RED}User Tidak Ditemukan!${NC}"
    fi
    sleep 2; dashboard_utama
}

