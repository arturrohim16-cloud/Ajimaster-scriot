        # 3b. Auto Configure Nginx Reverse Proxy for WebSocket
    cat <<EOF > /etc/nginx/sites-available/default
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name \$DOMAIN;

