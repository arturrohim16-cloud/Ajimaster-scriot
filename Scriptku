draw_bar() {
    local perc=$1
    local size=10
    local filled=$((perc * size / 100))
    local empty=$((size - filled))
    local COLOR=""
    if [ "$perc" -le 40 ]; then COLOR="\e[1;32m"; elif [ "$perc" -le 75 ]; then COLOR="\e[1;33m"; else COLOR="\e[1;31m"; fi
    printf "${COLOR}"
    for ((i=0; i<filled; i++)); do printf "█"; done
    printf "\e[0m"
    for ((i=0; i<empty; i++)); do printf "░"; done
}

