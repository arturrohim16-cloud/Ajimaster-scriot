install_udp() {
    clear
    echo -e "\e[1;35m🚀 MEMASANG UDP-CUSTOM TURBO ULTIMATE (MAX RACING MODE)...\e[0m"
    
    # 1. OPTIMASI KERNEL KHUSUS JALUR UDP MENTAH
    # Kita buka limit antrean data di sistem Linux agar tidak ada paket yang tertahan
    cat <<EOF > /etc/sysctl.d/99-ajimaster-udp-turbo.conf
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.core.rmem_default=16777216
net.core.wmem_default=16777216
net.core.netdev_max_backlog=5000
net.ipv4.udp_mem=10240 87380 16777216
net.ipv4.udp_rmem_min=16384
net.ipv4.udp_wmem_min=16384
EOF
    sysctl --system &>/dev/null

    # 2. BERSIHKAN VERSI LAMA
    systemctl stop udp-custom &>/dev/null
    rm -rf /etc/udp/config.json
    
    # 3. DOWNLOAD BINARY TERBARU
    mkdir -p /etc/udp
    wget -qO /usr/bin/udp-custom https://github.com/mizustore/repostore/raw/main/udp-custom-linux-amd64
    chmod +x /usr/bin/udp-custom

    # 4. KONFIGURASI BUFFER RAKSASA (ANTI-BENGONG & SPEED MAX)
    # Kita set stream_buffer ke 64MB untuk narik speed edukasi/opok sekuat tenaga
    cat <<EOF > /etc/udp/config.json
{
  "listen": ":36600",
  "stream_buffer": 67108864,
  "receive_buffer": 67108864,
  "auth": {
    "type": "password",
    "password": "ajimaster-udp"
  },
  "sniffing": {
    "enabled": true,
    "dest_override": ["http", "tls"]
  }
}
EOF

    # 5. SERVICE AUTO-RUNNING DENGAN AGGRESSIVE KEEP-ALIVE
    # -sock-timeout 600: Menjaga koneksi tetap hidup 10 menit meskipun sinyal hilang
    # -buffer 65535: Paket data maksimal dalam satu kiriman
    cat <<EOF > /etc/systemd/system/udp-custom.service
[Unit]
Description=UDP-Custom Turbo Ultimate By Ajimaster
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/bin
ExecStart=/usr/bin/udp-custom server -exclude 1-65535 -auth ajimaster-udp -buffer 65535 -sock-timeout 600
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable udp-custom
    systemctl restart udp-custom
    
    echo -e "\e[1;32m✅ UDP-CUSTOM TURBO ULTIMATE BERHASIL DIAKTIFKAN!\e[0m"
    echo -e "Password : ajimaster-udp"
    echo -e "Fitur    : Buffer 64MB, Kernel Tuning, Anti-RTO 600s"
    read -p "Tekan Enter untuk Kembali ke Menu"
    menu
}

