fi

# --- 4. CORE ENGINE: LIMIT & EXPIRED ---
function core_engine() {
    local now=$(date +%Y-%m-%d)
    while read line; do
        [ -z "$line" ] && continue
        user=$(echo $line | cut -d'|' -f1); exp=$(echo $line | cut -d'|' -f3)
        lim_ip=$(echo $line | cut -d'|' -f4); proto=$(echo $line | cut -d'|' -f6)

        if [[ "$now" > "$exp" ]]; then
            delete_logic "$user" "$proto"
            continue
        fi

        if [ "$proto" == "ssh" ]; then
            cip=$(netstat -anp | grep ESTABLISHED | grep sshd | grep -w "$user" | awk '{print $5}' | cut -d: -f1 | sort -u | wc -l)
            if [ "$cip" -gt "$lim_ip" ]; then
                passwd -l "$user"
                pkill -u "$user"
            else
                passwd -u "$user" 2>/dev/null
            fi
        else
            cip=$(grep -w "$user" /var/log/xray/access.log | tail -n 100 | awk '{print $3}' | cut -d: -f1 | sort -u | wc -l)
            if [ "$cip" -gt "$lim_ip" ]; then
                jq "del(.inbounds[].settings.clients[] | select(.email == \"$user\"))" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
                systemctl restart xray
            fi
        fi
    done < /etc/aji/users.db
}

# --- 5. DELETE LOGIC ---
function delete_logic() {
    local u=$1; local p=$2
    if [ "$p" == "ssh" ]; then userdel -f "$u"; else
        jq "del(.inbounds[].settings.clients[] | select(.email == \"$u\"))" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
        systemctl restart xray
    fi
    sed -i "/^$u|/d" /etc/aji/users.db
}

