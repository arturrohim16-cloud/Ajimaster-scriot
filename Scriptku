# --- 7. CREATE XRAY MANAGER ---
function xray_manager() {
    clear
    proto_type=$1
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e "         CREATE $proto_type ACCOUNT PREMIUM          "
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    read -p " Username : " user
    [[ -z "$user" ]] && dashboard_utama
    read -p " Limit IP : " iplim
    read -p " Masa Aktif (Hari) : " aktif
    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=$(date -d "$aktif days" +%Y-%m-%d)
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$user\"}]" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
    systemctl restart xray
    echo "$user|$uuid|$exp|$iplim|0|$proto_type" >> /etc/aji/users.db
    if [[ "$proto_type" == "VMESS" ]]; then
        cat <<EOF > /etc/aji/vmess_base.json
{"v":"2","ps":"$user","add":"$DOMAIN","port":"443","id":"$uuid","aid":"0","net":"ws","path":"/vmess","type":"none","host":"","tls":"tls"}
EOF
        link="vmess://$(base64 -w 0 /etc/aji/vmess_base.json)"
    elif [[ "$proto_type" == "VLESS" ]]; then
        link="vless://$uuid@$DOMAIN:443?path=/vless&security=tls&encryption=none&type=ws#$user"
    elif [[ "$proto_type" == "TROJAN" ]]; then
        link="trojan://$uuid@$DOMAIN:443?path=/trojan&security=tls&type=ws#$user"
    fi
    clear
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e "      \e[44;1;37m  DETAIL AKUN $proto_type PREMIUM  \e[0m"
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e " Remarks     : $user"
    echo -e " Domain      : $DOMAIN"
    echo -e " Port TLS    : 443"
    echo -e " UUID        : $uuid"
    echo -e " Expired     : $exp"
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    echo -e " ${YELLOW}LINK CONFIG :${NC}"
    echo -e ""
    echo -e "\e[107;30m$link\e[0m"
    echo -e ""
    echo -e "${RED}═══════════════════════════════════════════════════${NC}"
    read -p "Tekan Enter untuk kembali"
    dashboard_utama
}

