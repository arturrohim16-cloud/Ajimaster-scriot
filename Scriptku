trial_vmess() {
    clear
    echo -e "\e[1;33m      CREATE TRIAL VMESS PREMIUM (1 DAY)\e[0m"
    echo -e "-----------------------------------------------"
    read -p "   Username Trial : " user
    exp_date=$(date -d "1 days" +"%Y-%m-%d")
    uuid=$(cat /proc/sys/kernel/random/uuid)
    domain=$(cat /etc/xray/domain)
    
    # Masukkan ke Config Xray
    sed -i '/#vmess$/i ### '"$user $exp_date"'\n},{"id": "'"$uuid"'"\n#vmess' /etc/xray/config.json
    systemctl restart xray > /dev/null 2>&1

    # Buat Link Vmess (Pastikan domain terkunci di 'add' dan 'host')
