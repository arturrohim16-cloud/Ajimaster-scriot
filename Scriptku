    mkdir -p /root/backup_vpn
    cp /etc/passwd /root/backup_vpn/passwd.bak
    cp /etc/shadow /root/backup_vpn/shadow.bak
    cp /etc/group /root/backup_vpn/group.bak
    cp /usr/local/etc/xray/config.json /root/backup_vpn/xray.bak 2>/dev/null
