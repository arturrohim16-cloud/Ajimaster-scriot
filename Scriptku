}

trial_vmess() {
    clear
    echo -e "\e[1;33m      CREATE TRIAL VMESS PREMIUM (1 DAY)\e[0m"
    echo -e "-----------------------------------------------"
    read -p "   Username Trial : " user
    exp_date=$(date -d "1 days" +"%Y-%m-%d")
    uuid=$(cat /proc/sys/kernel/random/uuid)
    domain=$(cat /etc/xray/domain)
    
    # Masukkan ke Config Xray
    sed -i '/#vmess$/i ### '"$user $exp_date"'\n},{"id": "'"$uuid"'"\n#vmess' /etc/xray/config.json
    systemctl restart xray > /dev/null 2>&1

    # Buat Link Vmess (Pastikan domain terkunci di 'add' dan 'host')
    vmess_json='{"v":"2","ps":"'${user}'","add":"'${domain}'","port":"443","id":"'${uuid}'","aid":"0","scy":"auto","net":"ws","type":"none","host":"'${domain}'","path":"/vmess","tls":"tls"}'
    vmess_link="vmess://$(echo -n $vmess_json | base64 -w 0)"

    clear
    echo -e "   \e[1;32mSUCCESS CREATE TRIAL VMESS PREMIUM\e[0m"
    echo -e "-----------------------------------------------"
    echo -e "   Remarks  : $user"
    echo -e "   Domain   : $domain"
    echo -e "   Expired  : $exp_date (1 Hari)"
    echo -e "-----------------------------------------------"
    echo -e "   LINK VMESS (HTTP CUSTOM) :"
    echo -e "   $vmess_link"
    echo -e "-----------------------------------------------"
    read -n 1 -s -r -p "   Tekan sembarang tombol untuk kembali"
    menu_manager
}

