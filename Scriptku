add_trojan() {
    clear
    CONF="/usr/local/etc/xray/config.json"
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null); [[ -z $DOMAIN ]] && DOMAIN="aji.izz-store.my.id"
    
    echo -e "\e[1;35m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;33m      CREATE TROJAN PREMIUM         \e[0m \e[1;35m║\e[0m"
    echo -e "\e[1;35m╚════════════════════════════════════════╝\e[0m"
    read -p " 👤 Username : " user
    grep -qw "$user" "$CONF" && { echo -e "\e[1;31mUser sudah ada!\e[0m"; sleep 2; return; }
    read -p " 📅 Exp (Days) : " masaaktif
    
    pass=$user$(shuf -i 100-999 -n 1)
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

    # Injeksi JQ ke Inbound Index 2 (Trojan)
    jq '(.inbounds[] | select(.protocol == "trojan")).settings.clients += [{"password": "'$pass'", "email": "'$user'"}]' $CONF > $CONF.tmp && mv $CONF.tmp $CONF
    systemctl restart xray

    tr_link="trojan://$pass@$DOMAIN:2087?path=%2Ftrojan&security=none&type=ws#$user"

    clear
    echo -e "\e[1;35m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;32m      TROJAN ACCOUNT DETAILS        \e[0m \e[1;35m║\e[0m"
    echo -e "\e[1;35m╠════════════════════════════════════════╝\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;37mUser     : $user\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;37mPassword : $pass\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;37mExpired  : $exp\e[0m"
    echo -e "\e[1;35m╠════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;35m║\e[0m \e[1;33m🔐 URL TROJAN WS (2087)\e[0m"
    echo -e "\e[1;35m║\e[0m $tr_link"
    echo -e "\e[1;35m╚════════════════════════════════════════╝\e[0m"
    read -p " Tekan Enter untuk kembali..." menu
}

add_vless() {
    clear
    CONF="/usr/local/etc/xray/config.json"
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null); [[ -z $DOMAIN ]] && DOMAIN="aji.izz-store.my.id"
    
    echo -e "\e[1;36m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;33m      CREATE VLESS PREMIUM          \e[0m \e[1;36m║\e[0m"
    echo -e "\e[1;36m╚════════════════════════════════════════╝\e[0m"
    read -p " 👤 Username : " user
    grep -qw "$user" "$CONF" && { echo -e "\e[1;31mUser sudah ada!\e[0m"; sleep 2; return; }
    read -p " 📅 Exp (Days) : " masaaktif
    
    uuid=$(uuidgen)
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

    # Injeksi JQ ke Inbound Index 0 (Vless)
    jq '.inbounds |= map(if .protocol == "vless" then .settings.clients += [{"id": "'$uuid'", "email": "'$user'"}] else . end)' $CONF > $CONF.tmp && mv $CONF.tmp $CONF

    systemctl restart xray

    vless_tls="vless://$uuid@$DOMAIN:443?path=%2Fvless&security=tls&encryption=none&type=ws&host=$DOMAIN#$user"
    vless_http="vless://$uuid@$DOMAIN:80?path=%2Fvless&security=none&encryption=none&type=ws&host=$DOMAIN#$user"

    clear
    echo -e "\e[1;36m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;32m      VLESS ACCOUNT DETAILS         \e[0m \e[1;36m║\e[0m"
    echo -e "\e[1;36m╠════════════════════════════════════════╝\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;37mUser     : $user\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;37mDomain   : $DOMAIN\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;37mUUID     : $uuid\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;37mExpired  : $exp\e[0m"
    echo -e "\e[1;36m╠════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;33m🔐 URL VLESS TLS (443)\e[0m"
    echo -e "\e[1;36m║\e[0m $vless_tls"
    echo -e "\e[1;36m║\e[0m"
    echo -e "\e[1;36m║\e[0m \e[1;33m🔓 URL VLESS NON-TLS (80)\e[0m"
    echo -e "\e[1;36m║\e[0m $vless_http"
    echo -e "\e[1;36m╚════════════════════════════════════════╝\e[0m"
    read -p " Tekan Enter untuk kembali..." menu
}

add_vmess() {
    clear
    CONF="/usr/local/etc/xray/config.json"
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null); [[ -z $DOMAIN ]] && DOMAIN="aji.izz-store.my.id"
    
    echo -e "\e[1;34m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;33m      CREATE VMESS PREMIUM          \e[0m \e[1;34m║\e[0m"
    echo -e "\e[1;34m╚════════════════════════════════════════╝\e[0m"
    
    read -p " 👤 Username : " user
    if grep -qw "$user" "$CONF"; then
        echo -e "\e[1;31m User [ $user ] sudah ada!\e[0m"; sleep 2; return
    fi
    read -p " 📅 Exp (Days) : " masaaktif
    
    uuid=$(uuidgen)
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

    # --- JURUS PENGUNCI JQ (ANTI SALAH KAMAR) ---
    # Perintah ini memaksa JQ mencari objek yang punya protocol "vmess" secara spesifik
    jq --arg id "$uuid" --arg mail "$user" \
    '(.inbounds[] | select(.protocol == "vmess")).settings.clients += [{"id": $id, "alterId": 0, "email": $mail}]' \
    $CONF > $CONF.tmp && mv $CONF.tmp $CONF

    systemctl restart xray

    # Link Generator
    v_tls=$(echo -n "{\"v\":\"2\",\"ps\":\"$user\",\"add\":\"$DOMAIN\",\"port\":\"443\",\"id\":\"$uuid\",\"aid\":\"0\",\"net\":\"ws\",\"path\":\"/vmess\",\"type\":\"none\",\"host\":\"$DOMAIN\",\"tls\":\"tls\"}" | base64 -w 0)
    v_ntls=$(echo -n "{\"v\":\"2\",\"ps\":\"$user\",\"add\":\"$DOMAIN\",\"port\":\"80\",\"id\":\"$uuid\",\"aid\":\"0\",\"net\":\"ws\",\"path\":\"/vmess\",\"type\":\"none\",\"host\":\"$DOMAIN\",\"tls\":\"none\"}" | base64 -w 0)

    clear
    echo -e "\e[1;34m╔════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;32m      VMESS ACCOUNT DETAILS         \e[0m \e[1;34m║\e[0m"
    echo -e "\e[1;34m╠════════════════════════════════════════╝\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;37mUser     : $user\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;37mExpired  : $exp\e[0m"
    echo -e "\e[1;34m╠════════════════════════════════════════╗\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;33m🔐 URL VMESS TLS (443)\e[0m"
    echo -e "\e[1;34m║\e[0m vmess://$v_tls"
    echo -e "\e[1;34m║\e[0m"
    echo -e "\e[1;34m║\e[0m \e[1;33m🔓 URL VMESS NON-TLS (80)\e[0m"
    echo -e "\e[1;34m║\e[0m vmess://$v_ntls"
    echo -e "\e[1;34m╚════════════════════════════════════════╝\e[0m"
    read -p " Tekan Enter untuk kembali..." menu
}

add_ssh() {
    clear
    # Mengambil Info IP dan Domain secara akurat
    MYIP=$(wget -qO- ipinfo.io/ip);
    # Mencoba membaca domain, jika file tidak ada atau kosong, pakai domain manual Mas
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null); 
    if [[ -z "$DOMAIN" ]]; then 
        DOMAIN="aji.izz-store.my.id"; 
    fi

    echo -e "\e[1;35m╔═══════════════════════════════════════════════════╗\e[0m"
    echo -e "   \e[1;33m🛠️  CREATE SSH PREMIUM ACCOUNT  🛠️\e[0m"
    echo -e "\e[1;35m╚═══════════════════════════════════════════════════╝\e[0m"
    read -p "  👤 Username   : " user
    # Cek apakah user sudah ada
    if grep -w "^$user" /etc/passwd > /dev/null; then
        echo -e "\e[1;31m  Error: Username '$user' sudah ada!\e[0m"
        sleep 2
        add_ssh
    fi
    read -p "  🔑 Password   : " pass
    read -p "  📅 Exp (Days) : " masaaktif
    read -p "  🚫 Limit IP   : " iplimit
    read -p "  📉 Limit GB   : " gblimit

    # Proses di sistem
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
    useradd -e $exp -s /bin/false -M $user
    echo "$user:$pass" | chpasswd
    # Menyimpan limit di comment user (opsional untuk script limit)
    usermod -c "MaxIP:$iplimit | MaxGB:$gblimit" $user

    # --- HASIL CREATE (KOTAK PUTIH TEKS HIJAU) ---
    clear
    echo -e "\e[1;32m\e[47m" # Background Putih, Teks Hijau
    echo -e " ╔══════════════════════════════════════════════╗ "
    echo -e " ║          SSH PREMIUM - AJIMASTER             ║ "
    echo -e " ╠══════════════════════════════════════════════╣ "
    echo -e "   Host/Domain: $DOMAIN"
    echo -e "   IP Address : $MYIP"
    echo -e "   Username   : $user"
    echo -e "   Password   : $pass"
    echo -e "   Limit IP   : $iplimit IP"
    echo -e "   Limit GB   : $gblimit GB"
    echo -e "   Expired    : $exp ($masaaktif Days)"
    echo -e " ╠══════════════════════════════════════════════╣ "
    echo -e "   FORMAT HTTP CUSTOM (NON-TLS):"
    echo -e "   $DOMAIN:80@$user:$pass"
    echo -e " "
    echo -e "   FORMAT HTTP CUSTOM (TLS/SSL):"
    echo -e "   $DOMAIN:443@$user:$pass"
    echo -e " "
    echo -e "   FORMAT UDP CUSTOM:"
    echo -e "   $DOMAIN:1-65535@$user:$pass"
    echo -e " ╠══════════════════════════════════════════════╣ "
    echo -e "   PAYLOAD WEBSOCKET (PORT 80):"
    echo -e "   GET / HTTP/1.1[crlf]Host: $DOMAIN[crlf]Upgrade: websocket[crlf][crlf]"
    echo -e " ╚══════════════════════════════════════════════╝ "
    echo -e "\e[0m" # Reset warna

    echo ""
    read -p "  Tekan [ Enter ] untuk kembali ke Menu Utama..."
    dashboard_utama
}

trial_ssh() {
    clear
    echo -e "\e[1;33m      CREATE TRIAL SSH PREMIUM (1 DAY)\e[0m"
    echo -e "-----------------------------------------------"
    read -p "   Username Trial : " user
    if grep -w "^$user" /etc/passwd > /dev/null; then
        echo -e "   Error: Username [$user] sudah ada!"
        sleep 2; menu_manager
    fi
    read -p "   Password       : " pass
    
    exp_date=$(date -d "1 days" +"%Y-%m-%d")
    IP=$(wget -qO- ipinfo.io/ip)
    domain=$(cat /etc/xray/domain 2>/dev/null)
    [[ -z "$domain" ]] && domain=$IP

    # Eksekusi Pembuatan User
    useradd -e $exp_date -s /bin/false -M $user
    echo -e "$pass\n$pass" | passwd $user &> /dev/null

