# --- 9. DASHBOARD FULL INFO ---
draw_bar() {
    local perc=$1
    local size=10
    local filled=$((perc * size / 100))
    local empty=$((size - filled))
    local COLOR=""
    if [ "$perc" -le 40 ]; then COLOR="${GREEN}"; elif [ "$perc" -le 75 ]; then COLOR="${YELLOW}"; else COLOR="${RED}"; fi
    printf "${COLOR}"
    printf "%${filled}s" | tr ' ' '█'
    printf "${NC}"
    printf "%${empty}s" | tr ' ' '░'
}

