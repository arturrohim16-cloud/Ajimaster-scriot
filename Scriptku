# --- 4. CORE ENGINE: LIMIT & EXPIRED ---
function core_engine() {
    local now=$(date +%Y-%m-%d)
    while read line; do
        [ -z "$line" ] && continue
        user=$(echo $line | cut -d'|' -f1); exp=$(echo $line | cut -d'|' -f3)
        lim_ip=$(echo $line | cut -d'|' -f4); proto=$(echo $line | cut -d'|' -f6)

        if [[ "$now" > "$exp" ]]; then
            delete_logic "$user" "$proto"
            continue
        fi

        if [ "$proto" == "ssh" ]; then
            cip=$(netstat -anp | grep ESTABLISHED | grep sshd | grep -w "$user" | awk '{print $5}' | cut -d: -f1 | sort -u | wc -l)
            if [ "$cip" -gt "$lim_ip" ]; then
                passwd -l "$user"
                pkill -u "$user"
            else
                passwd -u "$user" 2>/dev/null
            fi
        else
            cip=$(grep -w "$user" /var/log/xray/access.log | tail -n 100 | awk '{print $3}' | cut -d: -f1 | sort -u | wc -l)
            if [ "$cip" -gt "$lim_ip" ]; then
                jq "del(.inbounds[].settings.clients[] | select(.email == \"$user\"))" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
                systemctl restart xray
            fi
        fi
    done < /etc/aji/users.db
}

# --- 5. DELETE LOGIC ---
function delete_logic() {
    local u=$1; local p=$2
    if [ "$p" == "ssh" ]; then userdel -f "$u"; else
        jq "del(.inbounds[].settings.clients[] | select(.email == \"$u\"))" $XRAY_CONF > /tmp/xray.tmp && mv /tmp/xray.tmp $XRAY_CONF
        systemctl restart xray
    fi
    sed -i "/^$u|/d" /etc/aji/users.db
}

# --- 6. CREATE SSH (3 PORT: 80,443,UDP) ---
function create_ssh() {
    clear
    echo -e "${CYAN}━━━━━ CREATE SSH/TRIAL NOC GRADE ━━━━━${NC}"
    read -p " Username  : " u; [ -z "$u" ] && return
    read -p " Password  : " p; [ -z "$p" ] && return
    read -p " Exp (Day) : " d; [[ ! "$d" =~ ^[0-9]+$ ]] && return
    read -p " Limit IP  : " li; [[ ! "$li" =~ ^[0-9]+$ ]] && return

    exp=$(date -d "$d days" +%Y-%m-%d)
    
    # Membuat user di sistem VPS
    useradd -e $exp -s /bin/false -M "$u" && echo "$u:$p" | chpasswd
    
    # Menyimpan data ke database internal
    echo "$u|$p|$exp|$li|0|ssh" >> /etc/aji/users.db

    # Tampilan Dashboard Akun untuk Pembeli
    clear
    echo -e "${RED}══════════════════════════════════════${NC}"
    echo -e "      ${YELLOW}SSH WEBSOCKET ACCOUNT${NC}"
    echo -e "${RED}══════════════════════════════════════${NC}"
    echo -e " Host       : $DOMAIN"
    echo -e " User       : $u"
    echo -e " Pass       : $p"
    echo -e " Expired    : $exp"
    echo -e " Limit IP   : $li User"
    echo -e "--------------------------------------"
    echo -e " Port TLS   : 443 (WebSocket)"
    echo -e " Port NTLS  : 80 (WebSocket)"
    echo -e " Path       : /ssh"
    echo -e " UDP Port   : 7200"
    echo -e "--------------------------------------"
    echo -e " Payload (HTTP Custom):"
    echo -e "${CYAN}GET /ssh HTTP/1.1[crlf]Host: $DOMAIN[crlf]Upgrade: websocket[crlf][crlf]${NC}"
    echo -e "${RED}══════════════════════════════════════${NC}"
    echo -e " Cara Pakai: Masukkan Host & Payload di HC,"
    echo -e " centang SSL jika menggunakan Port 443."
    echo -e "${RED}══════════════════════════════════════${NC}"
    
    read -p "Enter to menu..."
}

# --- 7. CREATE XRAY (VMESS/VLESS/TROJAN) ---
function xray_manager() {
    clear
    echo -e " [1] VMESS [2] VLESS [3] TROJAN [0] BACK"
    read -p " Pilih: " opt; [ "$opt" == "0" ] && return
    case $opt in 1) pr="vmess";; 2) pr="vless";; 3) pr="trojan";; *) return;; esac
    
    read -p " User: " u; read -p " Exp (Day): " d; read -p " Limit IP: " li
    uid=$(uuidgen); exp=$(date -d "$d days" +%Y-%m-%d)

    # Tambahkan ke JSON
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uid\", \"email\": \"$u\"}]" $XRAY_CONF > /tmp/x.tmp && mv /tmp/x.tmp $XRAY_CONF
    systemctl restart xray

    echo "$u|null|$exp|$li|0|$pr|$uid" >> /etc/aji/users.db
    echo -e "${GREEN}Success! Link:${NC}"
    echo -e "$pr://$uid@$DOMAIN:80#$u"
    echo -e "CRPC: $pr://$uid@$DOMAIN:443#$u"
    read -p "Enter to menu..."
}

