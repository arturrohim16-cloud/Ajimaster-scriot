    total_ram=$(free -m | grep Mem | awk '{print $2}')
    ram_usage=$(free -m | grep Mem | awk '{print $3}')
    RAM_VAL="${ram_usage}MB / ${total_ram}MB"

    # 2. CEK STATUS SERVICE
    pgrep -x sshd >/dev/null && st_ssh="\e[1;92mON \e[0m" || st_ssh="\e[1;31mOFF\e[0m"
    if pgrep -f "xray" > /dev/null; then st_xry="\e[1;92mON \e[0m"; else st_xry="\e[1;31mOFF\e[0m"; fi
    pgrep -x nginx >/dev/null && st_ngx="\e[1;92mON \e[0m" || st_ngx="\e[1;31mOFF\e[0m"
    pgrep -f "ws" >/dev/null && st_wse="\e[1;92mON \e[0m" || st_wse="\e[1;31mOFF\e[0m"

    # --- DEFINISI WARNA ---
    P='\033[1;95m' # Ungu (Garis)
    B='\033[1;34m' # Biru (Teks)
    W='\033[1;37m' # Putih (Data)
    NC='\033[0m'

    clear
    # --- HEADER LOGO ---
    echo -e " \e[1;35m      █████╗ ██╗██╗██╗  ██╗\e[0m"
    echo -e " \e[1;35m     ██╔══██╗ ██║██║██║  ██║\e[0m"
    echo -e " \e[1;35m     ███████║ ██║██║██║  ██║\e[0m"
    echo -e " \e[1;35m     ██║  ██║██  ██║██║╚████╔╝ \e[0m"
    echo -e " \e[1;35m     ╚═╝  ╚═╝╚█████╔╝╚═╝ ╚═══╝ \e[0m"

    # --- BOX 1: DATA SERVER ---
    echo -e "${P}┌──────────────────────────────────────────────────────────┐${NC}"
    echo -e "${P}│${NC}          ${B}• AJI SYSTEM VPN PANEL MENU •${NC}           ${P}│${NC}"
    echo -e "${P}├──────────────────────────────────────────────────────────┤${NC}"
    printf "${P}│${NC} ${B}%-15s${NC} : ${W}%-35s${NC} ${P}│${NC}\n" "System OS" "Debian GNU/Linux 10"
    printf "${P}│${NC} ${B}%-15s${NC} : ${W}%-35s${NC} ${P}│${NC}\n" "Server RAM" "$RAM_VAL"
    printf "${P}│${NC} ${B}%-15s${NC} : ${W}%-35s${NC} ${P}│${NC}\n" "System Uptime" "$UPTIME"
    printf "${P}│${NC} ${B}%-15s${NC} : ${W}%-35s${NC} ${P}│${NC}\n" "Current Domain" "$DOMAIN"
    printf "${P}│${NC} ${B}%-15s${NC} : ${W}%-35s${NC} ${P}│${NC}\n" "IP-VPS" "$MYIP"
    echo -e "${P}├──────────────────────────────────────────────────────────┤${NC}"
    echo -e "${P}│${NC} ${B}SSH:${st_ssh}${B} │ XRAY:${st_xry}${B} │ NGINX:${st_ngx}${B} │ WS:${st_wse}${NC}   ${P}│${NC}"
    echo -e "${P}├──────────────────────────────────────────────────────────┤${NC}"

    # --- BOX 2: TOTAL AKUN (MENGGUNAKAN VARIABEL YANG SUDAH DICUCI) ---
    printf "${P}│${NC}  ${B}%-11s${NC}: ${W}%-5s${NC}      ${P}│${NC}      ${B}%-11s${NC}: ${W}%-5s${NC}  ${P}│${NC}\n" "SSH/VPN" "$total_ssh" "VMESS/WS" "$total_vmess"
    printf "${P}│${NC}  ${B}%-11s${NC}: ${W}%-5s${NC}      ${P}│${NC}      ${B}%-11s${NC}: ${W}%-5s${NC}  ${P}│${NC}\n" "VLESS/WS" "$total_vless" "TROJAN/WS" "$total_trojan"
    echo -e "${P}├──────────────────────────────────────────────────────────┤${NC}"

    # --- BOX 3: DAFTAR MENU ---
    printf "${P}│${NC} ${B} [01] • SSH MENU    ${NC}  ${P}│${NC} ${B} [08] • BACKUP DA   ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [02] • VMESS MENU  ${NC}  ${P}│${NC} ${B} [09] • UPDATE SC   ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [03] • VLESS MENU  ${NC}  ${P}│${NC} ${B} [10] • REBOOT VPS  ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [04] • TROJAN MENU ${NC}  ${P}│${NC} ${B} [11] • EDIT SCRIPT ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [05] • DEL USER    ${NC}  ${P}│${NC} ${B} [12] • FIX SERVICE ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [06] • REBOOT      ${NC}  ${P}│${NC} ${B} [13] • BANNER      ${NC}  ${P}│${NC}\n"
    printf "${P}│${NC} ${B} [07] • EXTEND      ${NC}  ${P}│${NC} ${B} [00] • EXIT MENU   ${NC}  ${P}│${NC}\n"
    echo -e "${P}└──────────────────────────────────────────────────────────┘${NC}"
    echo ""
    read -p "  Pilih Nomor: " opt
    case $opt in
        1|01) add_ssh ;;
        2|02) add_vmess ;;
        3|03) add_vless ;;
        4|04) add_trojan ;;
        5|05) menu_manager ;;
        6|06) reboot ;;
        7|07) renew_user ;;
        8|08) run_speedtest ;;
        9|09) backup_data ;;
        10) restart_services ;;
        11) cek_online ;;
        12) fix_servis ;;
        13) edit_banner ;;
        0|00) exit ;;
        *) dashboard_utama ;;
    esac
}

